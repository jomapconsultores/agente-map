# ============================================================
# Sistema Multiagente de Entregables de Alto Nivel
# (propuestas, artículos científicos, TDR/compras públicas,
#  peer-review, tesis y documentos legales/técnicos)
# ============================================================
# 1. Crea tu API key en: https://console.anthropic.com/
# 2. Copia este archivo como .env
# 3. Pega tu clave abajo

ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# Modelo a usar (opciones: claude-sonnet-4-6 | claude-opus-4-8)
# claude-opus-4-8 da mayor calidad pero es más lento y costoso
ANTHROPIC_MODEL=claude-sonnet-4-6

# Idioma de la interfaz (es | en | fr | pt)
SYSTEM_LANGUAGE=es

# ── Constructores no-Claude (redactor + financiero) ─────────────────────────
# El revisor/corrector SIEMPRE es Claude. Estos modelos CONSTRUYEN el documento
# en rotación por ciclo: ciclo 1 Mistral, ciclo 2 Codestral, ciclo 3 DeepSeek…
# Mistral/Codestral: https://console.mistral.ai/  ·  DeepSeek: https://platform.deepseek.com/
MISTRAL_API_KEY=
CODESTRAL_API_KEY=
DEEPSEEK_API_KEY=

# Modelos (opcional; estos son los valores por defecto)
MISTRAL_MODEL=mistral-large-latest
CODESTRAL_MODEL=codestral-latest
DEEPSEEK_MODEL=deepseek-chat

# Endpoints (opcional). Si tu key de Codestral es de "La Plateforme" y no del
# endpoint dedicado, usa: CODESTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# CODESTRAL_BASE_URL=https://codestral.mistral.ai/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Orden de rotación de constructores (coma-separado) — usado solo como respaldo
BUILDER_ROTATION=mistral,codestral,deepseek

# ── Flujo por FASES con gates ≥90 y reinicio al inicio ──────────────────────
# Cada fase la PRODUCE una IA y la REVISA otra distinta. Si un gate da <90, el
# pipeline vuelve al inicio (reinvestiga). Claude clasifica y da el veredicto final.
#   Investigación web + análisis  -> ROLE_RESEARCH        (revisa ROLE_REVIEW_RESEARCH)
#   Redacción del documento       -> ROLE_WRITER          (revisa ROLE_REVIEW_WRITER)
#   Estructuración financiera     -> ROLE_FINANCIAL
ROLE_RESEARCH=deepseek
ROLE_REVIEW_RESEARCH=mistral
ROLE_WRITER=deepseek
ROLE_REVIEW_WRITER=mistral
ROLE_FINANCIAL=codestral

# Reintentos máximos del ciclo completo antes de entregar "inconcluso" (mejor versión).
MAX_PIPELINE_RESTARTS=5
# Umbral mínimo (0-100) que debe alcanzar cada fase en su gate intermedio.
PHASE_REVIEW_THRESHOLD=90

# ── Supabase (Project Settings → API) ───────────────────────
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXX
SUPABASE_SECRET_KEY=sb_secret_XXX
SUPABASE_SERVICE_ROLE_JWT=eyJhbGciOi...

# ── API HTTP (solo si expones api/main.py vía uvicorn) ───────
# Clave del panel web (X-API-Key). En Coolify la defines tú aquí; en Render
# se autogeneraba con `generateValue: true`. Usa un secreto largo y aleatorio.
AGENTE_MAP_API_KEY=cambiame_por_un_secreto_largo_y_random

# ── Despliegue ───────────────────────────────────────────────
# App en Coolify (Dockerfile en la raíz, puerto 8000) · BD en Supabase.
# Guía: DEPLOY_COOLIFY.md.
#
# Dominio público fijo (recomendado para WebAuthn/biometría: la ata a este
# dominio sin depender del header Host). Debe coincidir con el dominio que
# pongas en Coolify y en tu DNS.
WEBAUTHN_RP_ID=proyectos.pensamiento-libre.org
WEBAUTHN_ORIGIN=https://proyectos.pensamiento-libre.org
